# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Database (Drizzle + libSQL)
# Local dev: DATABASE_URL=file:./local.db, DATABASE_AUTH_TOKEN can stay empty.
# Production: Turso database URL + auth token (see Milestone 2).
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Claude API (server-side only — never expose to the client bundle)
ANTHROPIC_API_KEY=

# Auth.js
# AUTH_SECRET: generate with `npx auth secret`
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth app (create one at https://github.com/settings/developers ->
# "New OAuth App"; callback URL is <AUTH_URL>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Not currently read anywhere -- sign-in is open to any GitHub account.
# Reserved for a possible future admin-marker use (e.g. flagging this
# login as an admin once admin-only features exist).
AUTH_GITHUB_OWNER_LOGIN=

# Numeric GitHub user id (not the login) to manually re-seed/backfill demo
# data for via `npm run db:seed` -- useful for refreshing a specific user's
# demo boards on demand. Not required for normal sign-in: boards auto-seed
# with demo data for any user on their first visit. Look this id up at
# https://api.github.com/users/<login> -> "id".
SEED_OWNER_GITHUB_ID=
